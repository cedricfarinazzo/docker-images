ARG PYTHON_VERSION=3.14

# --- builder ---------------------------------------------------------------
# Compile TA-Lib in a throwaway stage. Build toolchain stays here so the
# runtime image carries only the resulting library + headers.
FROM python:${PYTHON_VERSION}-slim AS builder

ARG TALIB_VERSION=0.6.4
ARG TALIB_SHA256=aa04066d17d69c73b1baaef0883414d3d56ab3775872d82916d1cdb376a3ae86

RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends \
      build-essential \
      wget \
      ca-certificates \
 && wget -O /tmp/ta-lib.tar.gz https://github.com/ta-lib/ta-lib/releases/download/v${TALIB_VERSION}/ta-lib-${TALIB_VERSION}-src.tar.gz \
 && echo "${TALIB_SHA256}  /tmp/ta-lib.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/ta-lib.tar.gz -C /tmp \
 && cd /tmp/ta-lib-${TALIB_VERSION} \
 && ./configure --prefix=/opt/ta-lib \
 && make -j"$(nproc)" \
 && make install \
 && mkdir -p /out \
 && cp -a /opt/ta-lib/. /out/ \
 && ls -lR /out

# --- runtime ---------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim

ARG PYTHON_VERSION
ARG TALIB_VERSION=0.6.4

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    LD_LIBRARY_PATH=/usr/lib \
    TA_LIBRARY_PATH=/usr/lib \
    TA_INCLUDE_PATH=/usr/include

# Pick up upstream debian patches that landed since python:slim was cut.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*

# Bring TA-Lib runtime + headers (+ ta-lib-config if upstream still
# ships it) into a clean image. No build-essential, no wget. Downstream
# callers that need to `pip install ta-lib` should add their own build
# toolchain on top.
COPY --from=builder /out/ /usr/

RUN ldconfig

LABEL org.opencontainers.image.source="https://github.com/cedricfarinazzo/docker-images" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="py-ta-lib" \
      org.opencontainers.image.description="Python ${PYTHON_VERSION} (debian slim) + TA-Lib C library ${TALIB_VERSION}" \
      io.cedricfarinazzo.python-version="${PYTHON_VERSION}" \
      io.cedricfarinazzo.talib-version="${TALIB_VERSION}" \
      io.cedricfarinazzo.distro="debian"
